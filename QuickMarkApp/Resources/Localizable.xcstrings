        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionaremos un ejemplo en Finder. Presiona la barra espaciadora para previsualizarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder でサンプルを選択します。スペースキーでプレビューしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionaremos um exemplo no Finder. Pressione a barra de espaço para visualizá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会在访达中选中一个示例。\n按空格键即可预览。"
          }
        }
      }
    },
    "What changed": {
      "localizations": {
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更点"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que mudou"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主要变化"
          }
        }
      }
    },
    "You can use Open Markdown while you sort this out.": {
      "localizations": {
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes usar Abrir Markdown mientras resuelves esto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題の解決中も「Markdown を開く」を使用できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode usar Abrir Markdown enquanto resolve isso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排查期间，你仍可使用“打开 Markdown”。"
          }
        }
      }
    },
    "Your PDF is ready to save.": {
      "localizations": {
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu PDF está listo para guardarse."
